spring:
  application:
    name: Sistema

  datasource:
    url: jdbc:mysql://localhost:3306/syscadastro?useUnicode=yes&characterEncoding=UTF-8
    username: root
    password: Guto!0001
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    show-sql: true
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQL8Dialect
        boot:
          allow_jdbc_metadata_access: false

# ===============================
# = Swagger/OpenAPI
# ===============================
springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui
    operationsSorter: method
    tagsSorter: alpha
    tryItOutEnabled: true
    filter: true

# Chave que será criptografada para utilização no processo de criação do Token de autorização.
# Não devemos definir a chave neste arquivo. O ideal é utilizar variáveis de ambiente,
# e em ambientes de produção, é recomendado remover dados sensíveis de senha/chaves/acesso do BD.
api:
  security:
    token:
      secret: my-secret-key-for-application

endpoint:
  front: http://localhost:4200/
